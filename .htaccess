# =========================================================================
# SIA 2027 Election Intelligence & Party Agent Command Portal
# Production Apache / cPanel Hardened Configuration
# =========================================================================

DirectoryIndex index.php index.html

# 1. Deny direct HTTP access to sensitive directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(database|tests|samples|_archive)/.*$ - [F,L]
</IfModule>

# 2. Deny access to sensitive files, database dumps, logs, and seeders
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sqlite|sqlite3|sw[op]|sample)|~|^\.env|seed.*\.php)$">
    Order allow,deny
    Deny from all
    Require all denied
</FilesMatch>

# 3. Disable directory browsing
Options -Indexes

# 4. Default Charset
AddDefaultCharset UTF-8

# 5. Disable PHP execution in uploads folder
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>

# 6. HTTP Security Headers & Content-Security-Policy
<IfModule mod_headers.c>
    # Prevent MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Cross-site scripting filter
    Header set X-XSS-Protection "1; mode=block"

    # Content-Security-Policy (Allow self, Tailwind CDN, cdnjs, Google Fonts, data/blob for images)
    Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com data: blob:;"
</IfModule>

# 7. Compression (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 8. Browser Caching (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
